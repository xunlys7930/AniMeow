# 追番喵后端服务环境变量模板
#
# 把本文件复制为 .env 后填入真实值。**.env 文件已在 .gitignore 中，不会被提交。**
# 部署到服务器时也用同样的方式：放一份 .env 在 app.js 同目录即可。

# ============ 数据库配置 ============
DB_HOST=127.0.0.1
DB_USER=zhuifanmiao
DB_PASSWORD=replace_with_your_db_password
DB_NAME=zhuifanmiao

# ============ API 鉴权 ============
# 客户端调用 /api/* 接口时使用的 Bearer Token。
# 客户端构建时通过 --dart-define=API_TOKEN=同样的值 注入。
# 建议用强随机字符串，例如 32 字节 hex：openssl rand -hex 32
API_TOKEN=replace_with_a_strong_random_token

# ============ 服务端口 ============
PORT=3000

# ============ 客户端检查更新（/api/check-update，可选）============
# 不设置 UPDATE_VERSION_NAME 时返回空版本名，客户端不会提示有更新。
UPDATE_VERSION_CODE=0
UPDATE_VERSION_NAME=
UPDATE_CHANGELOG=
UPDATE_FORCE=false
UPDATE_DOWNLOAD_URL=
# 多线路 JSON，与客户端 downloadUrls 一致（可选）
# UPDATE_DOWNLOAD_URLS_JSON={"国内":"https://..."}
