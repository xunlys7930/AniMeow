# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://api.example.com
JSON_LIMIT=32mb

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=animeow
DB_PASSWORD=replace_with_a_database_password
DB_NAME=animeow

# Authentication (generate independent random values; never commit the real ones)
API_TOKEN=replace_with_at_least_32_random_bytes
USER_TOKEN_SECRET=replace_with_a_different_32_byte_random_secret
USER_TOKEN_TTL_SECONDS=2592000

# User backup limits
USER_BACKUP_MAX_BYTES=20971520
USER_BACKUP_KEEP_COUNT=3
USER_BACKUP_COOLDOWN_SECONDS=300

# Optional AI analysis
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000
ANIME_ANALYSIS_TZ=Asia/Shanghai
ANIME_ANALYSIS_MAX_STATS_BYTES=61440

# Update service
UPDATE_VERSION_CODE=24
UPDATE_VERSION_NAME=1.3.7
UPDATE_CHANGELOG=Describe this release
UPDATE_FORCE=false
UPDATE_DOWNLOAD_URL=https://example.com/AniMeow-1.3.7.apk
